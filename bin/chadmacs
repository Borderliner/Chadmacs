#!/usr/bin/env bash
# chadmacs - manage the Chadmacs Emacs distribution.
#
# Subcommands:
#   update    Pull latest from upstream and update Elpaca packages.
#   doctor    Diagnose dependencies (Emacs, fonts, fd, rg, direnv, modules, ...).
#   uninstall Remove ~/.emacs.d (with confirmation; var/ backed up first).
#   help      Show this help.

set -euo pipefail

CHADMACS_DIR="${CHADMACS_DIR:-$HOME/.emacs.d}"
CHADMACS_VAR="$CHADMACS_DIR/var"

# ---- colors -----------------------------------------------------------------
if [ -t 1 ] && command -v tput >/dev/null 2>&1 && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
  C_RESET="$(tput sgr0)"
  C_BOLD="$(tput bold)"
  C_RED="$(tput setaf 1)"
  C_GREEN="$(tput setaf 2)"
  C_YELLOW="$(tput setaf 3)"
  C_BLUE="$(tput setaf 4)"
  C_DIM="$(tput dim)"
else
  C_RESET= C_BOLD= C_RED= C_GREEN= C_YELLOW= C_BLUE= C_DIM=
fi

ok()   { printf '%s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
err()  { printf '%s✗%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }
info() { printf '%s•%s %s\n' "$C_BLUE" "$C_RESET" "$*"; }
hdr()  { printf '\n%s%s%s\n' "$C_BOLD" "$*" "$C_RESET"; }

# ---- helpers ----------------------------------------------------------------
have() { command -v "$1" >/dev/null 2>&1; }

# Check binary on PATH; report.
check_bin() {
  local name="$1" purpose="$2" hint="${3:-}"
  if have "$name"; then
    ok "$name ($(command -v "$name")) — $purpose"
  elif [ -n "$hint" ]; then
    warn "$name not found — $purpose. ${C_DIM}install: $hint${C_RESET}"
  else
    warn "$name not found — $purpose"
  fi
}

# ---- subcommands ------------------------------------------------------------

cmd_help() {
  cat <<EOF
${C_BOLD}chadmacs${C_RESET} — manage the Chadmacs Emacs distribution

${C_BOLD}USAGE${C_RESET}
  chadmacs <command> [options]

${C_BOLD}COMMANDS${C_RESET}
  update         Pull upstream changes and rebuild Elpaca packages.
  doctor         Diagnose required + optional dependencies.
  fix-fd         Symlink Ubuntu/Debian's 'fdfind' as 'fd' in ~/.local/bin.
  treesit-clean  Delete all installed tree-sitter grammars (forces
                 reinstall at pinned ABI 14 revisions on next Emacs
                 start). Use after a "version-mismatch: 15" warning.
  uninstall      Remove ~/.emacs.d (your var/ is backed up first).
  help           Show this help.

${C_BOLD}ENV${C_RESET}
  CHADMACS_DIR    Override install location (default: ~/.emacs.d)
EOF
}

cmd_fix_fd() {
  hdr "Fix fd <- fdfind symlink"

  if have fd; then
    ok "fd already on PATH ($(command -v fd)). Nothing to do."
    return 0
  fi

  if ! have fdfind; then
    err "fdfind not installed."
    info "  Debian / Ubuntu: sudo apt install fd-find"
    info "  Other distros:   see https://github.com/sharkdp/fd#installation"
    exit 1
  fi

  local target
  target=$(command -v fdfind)
  local link_dir="$HOME/.local/bin"
  local link="$link_dir/fd"

  mkdir -p "$link_dir"
  ln -sf "$target" "$link"
  ok "Symlinked $link -> $target"

  # PATH check
  case ":$PATH:" in
    *":$link_dir:"*)
      ok "$link_dir already on \$PATH."
      ;;
    *)
      warn "$link_dir is NOT on your current \$PATH."
      info "  Add to your shell rc, e.g.:"
      info "    bash/zsh:  echo 'export PATH=\"\$HOME/.local/bin:\$PATH\"' >> ~/.bashrc"
      info "    fish:      fish_add_path -gP \$HOME/.local/bin"
      info "  Then restart your shell."
      ;;
  esac
}

cmd_update() {
  if [ ! -d "$CHADMACS_DIR/.git" ]; then
    err "$CHADMACS_DIR is not a git checkout. Skipping git pull."
    exit 1
  fi

  hdr "Updating Chadmacs in $CHADMACS_DIR"

  cd "$CHADMACS_DIR"

  # Local-uncommitted-changes guard
  if ! git diff-index --quiet HEAD -- 2>/dev/null; then
    warn "You have local uncommitted changes. Stash or commit them first:"
    printf '  git -C "%s" status\n' "$CHADMACS_DIR" >&2
    exit 2
  fi

  info "git fetch + pull --ff-only origin"
  git fetch --quiet origin
  git pull --ff-only

  hdr "Updating Elpaca packages"
  info "Launching Emacs in batch to run elpaca-update-all..."
  emacs --batch -l "$CHADMACS_DIR/early-init.el" -l "$CHADMACS_DIR/init.el" \
    --eval '(when (fboundp (quote elpaca-fetch-all)) (elpaca-fetch-all))' \
    --eval '(when (fboundp (quote elpaca-process-queues)) (elpaca-process-queues))' \
    2>&1 | tail -40 || warn "Elpaca update returned non-zero; run M-x elpaca-manager in Emacs to inspect."

  ok "Chadmacs is up to date."
  info "Restart Emacs and watch *elpaca-log* for any build failures."
}

cmd_doctor() {
  hdr "Chadmacs doctor — $CHADMACS_DIR"

  # ---- Emacs ----
  if have emacs; then
    local ev
    ev=$(emacs --batch --eval '(princ emacs-version)' 2>/dev/null || echo "?")
    local major
    major=$(printf '%s' "$ev" | cut -d. -f1)
    if [ "$major" -ge 29 ] 2>/dev/null; then
      ok "Emacs $ev"
    else
      err "Emacs $ev is too old. Chadmacs requires Emacs 29+."
    fi
  else
    err "Emacs not installed."
  fi

  # ---- Repo state ----
  if [ -d "$CHADMACS_DIR/.git" ]; then
    local head
    head=$(git -C "$CHADMACS_DIR" rev-parse --short HEAD 2>/dev/null || echo "?")
    ok "Repo at $CHADMACS_DIR (HEAD $head)"
  else
    warn "$CHADMACS_DIR is not a git repo — \`chadmacs update' will not work."
  fi

  # ---- Required binaries ----
  hdr "Required"
  check_bin git "version control + Elpaca + magit"
  check_bin make "Elpaca builds some packages"

  # ---- Highly recommended ----
  hdr "Recommended"
  check_bin rg "consult-ripgrep / project search" "https://github.com/BurntSushi/ripgrep"
  # fd on Debian/Ubuntu is packaged as `fd-find' and the binary is
  # `fdfind' to avoid collision with an unrelated package. Detect both;
  # if only `fdfind' is present, advise the symlink that upstream
  # recommends in their README.
  if have fd; then
    ok "fd ($(command -v fd)) — find-file / dirvish fast finder"
  elif have fdfind; then
    warn "fd not found, but fdfind is ($(command -v fdfind))."
    info "  Debian / Ubuntu ships fd as 'fdfind'. Symlink it as 'fd':"
    info "    ${C_BOLD}chadmacs fix-fd${C_RESET}"
    info "  or manually:"
    info "    mkdir -p ~/.local/bin && ln -sf \"\$(command -v fdfind)\" ~/.local/bin/fd"
    info "    (and make sure ~/.local/bin is on PATH)"
  else
    warn "fd not found — find-file / dirvish fast finder. install: https://github.com/sharkdp/fd"
  fi
  check_bin direnv "envrc per-project env" "https://direnv.net"

  # Ghostel replaces vterm. Its native module is a prebuilt binary that
  # auto-downloads on first `M-x ghostel', so no cmake / libvterm needed.
  # Sanity-check that Emacs was built with dynamic module support.
  if emacs --batch --eval '(prin1 (bound-and-true-p module-file-suffix))' 2>/dev/null \
       | grep -qE '"\.(so|dylib|dll)"'; then
    ok "Emacs has dynamic module support — Ghostel will auto-install its native module."
  else
    warn "Emacs lacks dynamic module support — Ghostel cannot load its native module."
    info "  Rebuild Emacs with --with-modules, or install a build that has it."
  fi

  # ---- Font ----
  # Nerd-font packagers ship the same font under several family names.
  # Accept any of the common variants.
  hdr "Fonts"
  local font_candidates=(
    "JetBrainsMono Nerd Font"
    "JetBrainsMono NF"
    "JetBrainsMonoNerdFont"
    "JetBrains Mono Nerd Font"
    "JetBrainsMono Nerd Font Mono"
  )
  local font_found=""
  if have fc-list; then
    local fc_output
    fc_output=$(fc-list 2>/dev/null)
    # NOTE: we use a here-string (<<<) instead of `printf | grep' because
    # `grep -q' closes the pipe on first match, which gives the upstream
    # `printf' a SIGPIPE (exit 141). Combined with `pipefail' that turns
    # an otherwise-successful match into a pipeline failure, causing the
    # if-conditional to evaluate as false. Here-strings have no pipe and
    # avoid the whole class of problem.
    for cand in "${font_candidates[@]}"; do
      if grep -qiF "$cand" <<<"$fc_output"; then
        font_found="$cand"
        break
      fi
    done
  fi
  if [ -n "$font_found" ]; then
    ok "JetBrainsMono Nerd Font installed (family: \"$font_found\")"
  else
    warn "JetBrainsMono Nerd Font not found (checked all common variants)."
    info "  Looking for any of:"
    for cand in "${font_candidates[@]}"; do
      info "    \"$cand\""
    done
    info "  Install: https://www.nerdfonts.com/font-downloads"
    info "  After install: fc-cache -fv"
  fi

  # ---- LSP servers (informational) ----
  hdr "Language servers (per-language; install only what you use)"
  check_bin clangd       "C/C++ LSP"            "pacman -S clang | brew install llvm"
  check_bin pylsp        "Python LSP"           "pip install python-lsp-server"
  check_bin pyright      "Python LSP (Microsoft)" "pip install pyright"
  check_bin typescript-language-server "TS/TSX LSP" "npm i -g typescript-language-server"
  check_bin gopls        "Go LSP"               "go install golang.org/x/tools/gopls@latest"
  check_bin rust-analyzer "Rust LSP"            "rustup component add rust-analyzer"
  check_bin bash-language-server "Bash LSP"     "npm i -g bash-language-server"
  check_bin yaml-language-server "YAML LSP"     "npm i -g yaml-language-server"
  check_bin marksman     "Markdown LSP"         "cargo install marksman"
  check_bin lua-language-server "Lua LSP"       "pacman -S lua-language-server"
  check_bin terraform-ls "Terraform LSP"        "brew install hashicorp/tap/terraform-ls"

  # ---- var/ disk usage ----
  hdr "State"
  if [ -d "$CHADMACS_VAR" ]; then
    local size
    size=$(du -sh "$CHADMACS_VAR" 2>/dev/null | awk '{print $1}' || echo "?")
    info "var/ size: $size"
  else
    warn "var/ not present yet — will be created on first launch."
  fi

  # ---- Custom.el ----
  if [ -f "$CHADMACS_DIR/custom.el" ]; then
    ok "custom.el present at $CHADMACS_DIR/custom.el"
  else
    info "custom.el will be auto-created with the language-extension template on next start."
  fi

  hdr "Done."
}

cmd_treesit_clean() {
  hdr "Clean tree-sitter grammars"

  local ts_dir="$CHADMACS_VAR/tree-sitter"
  if [ ! -d "$ts_dir" ]; then
    ok "No grammars installed ($ts_dir does not exist)."
    return 0
  fi

  local count
  count=$(find "$ts_dir" -maxdepth 1 -name 'libtree-sitter-*.so' 2>/dev/null | wc -l)
  if [ "$count" -eq 0 ]; then
    ok "No grammars to clean."
    return 0
  fi

  info "Found $count installed grammar(s) in $ts_dir."
  printf 'Delete all of them? Type %sYES%s to proceed: ' "$C_BOLD" "$C_RESET"
  read -r confirm
  if [ "$confirm" != "YES" ]; then
    err "Aborted."
    exit 1
  fi

  rm -f "$ts_dir"/libtree-sitter-*.so
  ok "Deleted $count grammar(s)."
  info "Open a source file in Emacs and treesit-auto will reinstall at the"
  info "ABI-14-compatible revisions pinned by Chadmacs."
}

cmd_uninstall() {
  hdr "Uninstall Chadmacs"

  if [ ! -d "$CHADMACS_DIR" ]; then
    err "$CHADMACS_DIR does not exist."
    exit 1
  fi

  printf '%sThis will remove %s%s\n' "$C_YELLOW" "$CHADMACS_DIR" "$C_RESET"
  if [ -d "$CHADMACS_VAR" ]; then
    local backup="$HOME/chadmacs-var-backup-$(date +%Y%m%d-%H%M%S)"
    printf '%svar/ will be moved to %s%s\n' "$C_BLUE" "$backup" "$C_RESET"
  fi
  printf 'Type %sYES%s to proceed: ' "$C_BOLD" "$C_RESET"
  read -r confirm
  if [ "$confirm" != "YES" ]; then
    err "Aborted."
    exit 1
  fi

  if [ -d "$CHADMACS_VAR" ]; then
    local backup="$HOME/chadmacs-var-backup-$(date +%Y%m%d-%H%M%S)"
    mv "$CHADMACS_VAR" "$backup"
    ok "Backed up var/ to $backup"
  fi

  rm -rf "$CHADMACS_DIR"
  ok "Removed $CHADMACS_DIR."
  info "Your shell rc files still reference $CHADMACS_DIR/bin in PATH. Remove manually if desired."
}

# ---- dispatch ---------------------------------------------------------------
case "${1:-help}" in
  update)        shift; cmd_update        "$@" ;;
  doctor)        shift; cmd_doctor        "$@" ;;
  fix-fd)        shift; cmd_fix_fd        "$@" ;;
  treesit-clean) shift; cmd_treesit_clean "$@" ;;
  uninstall)     shift; cmd_uninstall     "$@" ;;
  help|-h|--help) cmd_help ;;
  *) err "Unknown command: $1"; cmd_help; exit 1 ;;
esac
